# Keep the image small and free of secrets/host-only artifacts.
.venv/
venv/
env/
**/__pycache__/
*.py[cod]
*.log

# Secrets & local state — provided at runtime via a mounted .env.production
.env
.env.*
!.env.example

# Regenerated at container start / mounted as a volume
staticfiles/
media/
db.sqlite3
db.sqlite3-journal

# VCS / editor
.git/
.gitignore
.vscode/
.idea/
