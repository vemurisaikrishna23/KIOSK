# =============================================================
# KIOSK backend — environment overrides
# Copy this file to `.env` (same directory) and fill in real values.
# Daphne picks these up at startup via python-dotenv.
# =============================================================

# ---- Gmail SMTP (for password-reset emails) ----
# Use a Gmail "App Password" — NOT your regular Gmail password.
# How to create one:
#   1. Turn on 2-Step Verification at https://myaccount.google.com/security
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate a 16-character password and paste it below (no spaces).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=KIOSK <your-gmail@gmail.com>

# ---- Frontend ----
# Origin of the React app — used to build clickable reset links inside the email.
FRONTEND_URL=http://localhost:5173
