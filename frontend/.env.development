# VITE_API_BASE_URL is intentionally unset in development so the frontend
# can resolve the backend host from window.location.hostname at runtime.
# That way:
#   - http://localhost:5173            → http://localhost:8001/api
#   - http://192.168.x.x:5173 (phone)  → http://192.168.x.x:8001/api
# Uncomment + set this line only if you need to force a specific backend URL.
# VITE_API_BASE_URL=http://localhost:8001/api
